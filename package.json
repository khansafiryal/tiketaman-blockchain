{
  "name": "tiketaman-prototype",
  "version": "0.1.0",
  "description": "Prototipe TiketAman: token tiket ERC-721 anti-calo + pembayaran QRIS/VA/e-wallet (sandbox Midtrans) + testnet Sepolia",
  "scripts": {
    "compile": "hardhat compile",
    "test:contract": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "test:e2e": "node --test --test-reporter=spec backend/test/e2e.test.js",
    "test:customer": "node --test --test-reporter=spec backend/test/customer-flow.test.js",
    "test:entry": "node --test --test-reporter=spec backend/test/entry-flow.test.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "demo": "node scripts/demo-local.js",
    "start": "node backend/src/server.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^1.0.10",
    "solc": "^0.8.24"
  },
  "dependencies": {
    "express": "^4.22.3",
    "qrcode": "^1.5.4"
  },
  "private": true
}
