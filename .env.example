
# --- Payment gateway (Midtrans SANDBOX) ---
PAYMENT_MODE=sandbox                 # sandbox = Snap sandbox Midtrans, simulator = simulator lokal
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false         # prototipe menolak berjalan bila true
MIDTRANS_VERIFY_STATUS=true          # challenge-response ke API status sebelum memproses

# --- Blockchain (testnet Sepolia) ---
RPC_URL=https://sepolia.infura.io/v3/xxxxxxxxxxxxxxxx
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/xxxxxxxxxxxxxxxx
DEPLOYER_PRIVATE_KEY=0x...           # hanya untuk deploy
OPERATOR_PRIVATE_KEY=0x...           # akun server (OPERATOR_ROLE)
GATE_PRIVATE_KEY=0x...               # akun pemindai gerbang (GATE_ROLE)
CONTRACT_ADDRESS=0x...
EXPLORER_BASE=https://sepolia.etherscan.io

# --- Keamanan aplikasi ---
WALLET_ENCRYPTION_KEY=               # 64 karakter hex (32 byte) untuk AES-256-GCM
IDENTITY_SALT=                       # salt hash NIM
QR_HMAC_SECRET=                      # kunci tanda tangan QR berputar
RATE_LIMIT_PER_MINUTE=30
MINT_MAX_ATTEMPTS=3
MINT_BACKOFF_MS=2000
DB_PATH=./tiketaman.db
PORT=3000
